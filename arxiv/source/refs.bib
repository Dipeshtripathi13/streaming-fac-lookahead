% ---------------------------------------------------------------------------
% Phonetics grounding for the H2 pre-registration. The prediction that vowels
% and approximants need more right context than obstruents rests on two
% classical claims: that vocalic identity is carried by formant movement over
% a syllable nucleus tens to hundreds of ms long, and that stop place is
% recoverable from a much shorter window around the release.
% ---------------------------------------------------------------------------

% PROVENANCE: [V] Authors, title, journal, volume, pages, year and DOI
%   (10.1121/1.1908183) verified. Measured syllable-nucleus durations in
%   American English from 1263 CNC words; the source of the 80-250 ms span.
@article{petersonlehiste1960,
  author  = {Peterson, Gordon E. and Lehiste, Ilse},
  title   = {Duration of Syllable Nuclei in {E}nglish},
  journal = {J. Acoust. Soc. Amer.},
  volume  = {32},
  number  = {6},
  pages   = {693--703},
  year    = {1960},
  doi     = {10.1121/1.1908183}
}

