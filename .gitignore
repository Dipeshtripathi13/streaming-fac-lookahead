# environments
.venv/
__pycache__/
*.pyc
*.egg-info/

# data (large, and L2-ARCTIC is CC-BY-NC — never commit corpora)
data/corpora/
*.wav
*.flac
*.onnx

# model checkpoints
checkpoints/
*.pt
*.ckpt

# superseded results
results/raw/_superseded/

# OS
.DS_Store
results/synth/
results/listening_test/

# Hypothesis dumps: the extracted per-condition JSON under results/raw/hyps/ is
# the source of truth for the listening test. The zips are redundant with it and
# never delta-compress, so they stay out of history.
results/raw/*hyps*.zip

# LaTeX build artefacts. main.tex, refs.bib and main.pdf are tracked; the
# intermediates are regenerated by `tectonic -X compile main.tex` and only
# create noise in diffs.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.log
paper/*.out
paper/*.xdv
