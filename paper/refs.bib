% PROVENANCE: [V] Authors, title and date (4 Sep 2025) verified. The 140 ms
%   figure is CONFIRMED from the full text and is a LOOK-AHEAD (LA): "we select
%   the 140ms LA with CL as our default streaming config", chosen because "an
%   extra 140ms of look-ahead yields a marginal <1pp absolute improvement at
%   the expense of doubling the buffering delay". End-to-end latency is 203 ms
%   at 140 ms LA against a stated 350 ms budget; zero-LA latency is 84.3 ms.
%   NOTE FOR RELATED WORK: DarkStream DOES ablate lookahead, over LA in
%   {0, 140, 280} ms -- so "nobody reports a lookahead ablation" is false and
%   has been corrected. It also describes a non-causal layer with "a receptive
%   field spanning up to 280 ms into the future", independent support for this
%   paper's causality argument. Measured on an RTX 3090 at 60 ms chunk.
@article{darkstream2025,
  author  = {Quamer, Waris and Guti{\'e}rrez-Osuna, Ricardo},
  title   = {{DarkStream}: Real-Time Speech Anonymization with Low Latency},
  journal = {arXiv preprint arXiv:2509.04667},
  year    = {2025},
  month   = sep
}

